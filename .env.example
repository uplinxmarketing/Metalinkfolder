# Copy this file to .env and fill in your own values.
# None of these are provided for you — see README.md for where to get each one.

# Supabase project settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# console.groq.com -> API Keys (used client-side for image/brand-reference analysis)
VITE_GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# The following are NOT client-side Vite vars. They are Supabase Edge Function
# secrets — set them in Supabase (Project → Edge Functions → Secrets), never in
# this file or the browser bundle:
#
#   ANTHROPIC_API_KEY   (optional) paid Claude key for the metalink-ai function.
#                       Leave unset to run copy generation on the free Groq path.
#   GROQ_API_KEY        Groq key for metalink-ai (free tier).
#   ADMIN_PASSWORD      Password for the dashboard login (verify-admin).
#   ADMIN_TOKEN_SECRET  Random string used to sign admin session tokens.
#   HF_API_TOKEN        Hugging Face token for the metalink-image function
#                       (huggingface.co → Settings → Access Tokens). Powers the
#                       one-click campaign creatives via FLUX.1-schnell (free).
#   HF_IMAGE_MODEL      (optional) override the image model, e.g.
#                       stabilityai/stable-diffusion-xl-base-1.0
